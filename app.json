{
  "expo": {
    "name": "Keypracticer Game",
    "slug": "keypracticer-game",
    "scheme": "keypracticer-game",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F5F0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.sidibe.keypracticergame",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Keypracticer Game listens to your guitar to check the notes you play."
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "de.sidibe.keypracticergame",
      "adaptiveIcon": {
        "backgroundColor": "#F5F5F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "Keypracticer Game listens to your guitar to check the notes you play.",
          "iosBackgroundMode": false,
          "androidPermissions": [
            "android.permission.RECORD_AUDIO",
            "android.permission.MODIFY_AUDIO_SETTINGS"
          ],
          "androidForegroundService": false
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
